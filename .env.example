# Jai Baba Electronic — Environment Variables
# Copy this file to .env.local for local overrides.
# In Vercel, set these in Project Settings -> Environment Variables.

# Formspree Contact Form Endpoint
# Option A: Just your Formspree Form ID (e.g., "mzzbklpq")
VITE_FORMSPREE_ID=

# Option B: Full Formspree URL (e.g., "https://formspree.io/f/mzzbklpq")
VITE_FORMSPREE_URL=

# Google Analytics 4 (optional, free) — e.g. "G-XXXXXXXXXX".
# Needed for WhatsApp/call click tracking on Vercel's free Hobby plan, where Vercel
# custom events are not recorded. Leave empty to disable.
VITE_GA_MEASUREMENT_ID=

# Sentry crash reporting (optional, free tier) — the project's DSN, e.g.
# "https://abc123@o456.ingest.sentry.io/789". Leave empty to disable.
VITE_SENTRY_DSN=

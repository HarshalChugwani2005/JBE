# Jai Baba Electronic — Environment Variables
# Copy this file to .env.local for local overrides.
# In Vercel, set these in Project Settings -> Environment Variables.

# Formspree Contact Form Endpoint
# Option A: Just your Formspree Form ID (e.g., "mzzbklpq")
VITE_FORMSPREE_ID=

# Option B: Full Formspree URL (e.g., "https://formspree.io/f/mzzbklpq")
VITE_FORMSPREE_URL=
